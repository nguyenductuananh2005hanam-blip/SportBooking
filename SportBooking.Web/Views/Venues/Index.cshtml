@model List<VenuesViewModel>
@{
    ViewData["Title"] = "Danh sách cụm sân";
}

<style>
    .venue-header {
        background: linear-gradient(135deg, #198754 0%, #20c997 100%);
        border-radius: 16px;
        padding: 32px 28px;
        color: #fff;
        margin-bottom: 28px;
        box-shadow: 0 8px 24px rgba(25, 135, 84, 0.2);
    }

    .venue-card {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .venue-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);
        }

    .venue-img-wrap {
        position: relative;
        height: 200px;
        background-color: #e9f5ef;
        overflow: hidden;
    }

        .venue-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.35s ease;
        }

    .venue-card:hover .venue-img-wrap img {
        transform: scale(1.05);
    }

    .venue-img-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #198754;
        font-size: 3rem;
        opacity: 0.5;
    }

    .field-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        background: rgba(25, 135, 84, 0.92);
        color: #fff;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.82rem;
        font-weight: 600;
        backdrop-filter: blur(4px);
    }

    .venue-title {
        font-weight: 700;
        color: #2c3e50;
        font-size: 1.15rem;
        margin-bottom: 10px;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .venue-info {
        font-size: 0.92rem;
        color: #5a6a7e;
        margin-bottom: 6px;
        display: flex;
        align-items: flex-start;
        gap: 8px;
    }

        .venue-info i {
            color: #198754;
            margin-top: 2px;
            flex-shrink: 0;
        }

    .venue-address {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .venue-price {
        font-weight: 700;
        color: #198754;
        font-size: 1.05rem;
    }

    .btn-detail {
        background: linear-gradient(135deg, #198754 0%, #20c997 100%);
        border: none;
        border-radius: 8px;
        font-weight: 600;
        padding: 8px 16px;
        color: #fff;
    }

        .btn-detail:hover {
            background: linear-gradient(135deg, #157347 0%, #1ba87e 100%);
            color: #fff;
        }
</style>

<div class="container py-4">
    <!-- Header -->
    <div class="venue-header">
        <h2 class="fw-bold mb-1">Danh sách cụm sân thể thao</h2>
        <p class="mb-0 opacity-75">
            Hiện có <strong>@Model.Count</strong> cụm sân đang hoạt động
        </p>
    </div>

    <!-- Danh sách sân -->
    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm">
            <i class="bi bi-calendar-x text-muted" style="font-size: 3rem;"></i>
            <h5 class="mt-3 fw-bold text-secondary">Chưa có cụm sân nào</h5>
            <p class="text-muted mb-0">Hiện chưa có cụm sân nào đang mở đặt lịch.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var venue in Model)
            {
                <div class="col">
                    <div class="card venue-card h-100">
                        <!-- Ảnh đại diện -->
                        <div class="venue-img-wrap">
                            @if (!string.IsNullOrWhiteSpace(venue.ImageUrl))
                            {
                                string filePath = $@"~/uploads/{venue.ImageUrl}";
                                <img src="@Url.Content(filePath)" alt="@venue.Name" loading="lazy" />
                            }
                            else
                            {
                                <div class="venue-img-placeholder">
                                    <i class="bi bi-image"></i>
                                </div>
                            }
                            <span class="field-badge">
                                <i class="bi bi-grid-fill me-1"></i>@venue.FieldCount sân
                            </span>
                        </div>

                        <!-- Thông tin sân -->
                        <div class="card-body d-flex flex-column">
                            <h5 class="venue-title" title="@venue.Name">@venue.Name</h5>

                            <div class="venue-info">
                                <i class="bi bi-geo-alt-fill"></i>
                                <span class="venue-address" title="@venue.Address">@venue.Address</span>
                            </div>

                            <div class="venue-info">
                                <i class="bi bi-clock-fill"></i>
                                <span>@venue.OpenTime - @venue.CloseTime</span>
                            </div>

                            <div class="venue-info mb-3">
                                <i class="bi bi-telephone-fill"></i>
                                <span>@venue.Phone</span>
                            </div>

                            <!-- Footer: Giá + Nút xem chi tiết -->
                            <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted d-block" style="font-size: 0.78rem;">Giá tham khảo</small>
                                    <span class="venue-price">
                                        @(venue.MinPrice.HasValue ? $"Từ {venue.MinPrice.Value:N0} đ" : "Liên hệ")
                                    </span>
                                </div>

                                <a asp-action="GetFieldsByVenue"
                                   asp-route-id="@venue.Id"
                                   class="btn btn-detail btn-sm">
                                    Xem sân <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>