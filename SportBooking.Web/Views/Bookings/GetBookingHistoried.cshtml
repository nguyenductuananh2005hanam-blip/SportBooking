@model IEnumerable<BookingHistoriedViewModel>

@{
    ViewData["Title"] = "Lịch sử đặt sân";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Lịch sử đặt sân</h2>
            <p class="text-muted mb-0">Theo dõi các lịch đặt sân của bạn</p>
        </div>
        <a asp-controller="Venues" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Đặt sân mới
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <i class="bi bi-calendar-x text-muted" style="font-size: 3rem;"></i>
                <h5 class="mt-3 fw-semibold">Chưa có lịch sử đặt sân</h5>
                <p class="text-muted">Bạn chưa thực hiện giao dịch đặt sân nào.</p>
                <a asp-controller="Field" asp-action="Index" class="btn btn-outline-primary mt-2">
                    Tìm sân ngay
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">#Mã</th>
                            <th>Tên sân</th>
                            <th>Thời gian đá</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th>Ghi chú</th>
                            <th>Ngày đặt</th>
                            <th>Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var statusBadge = item.Status.ToString().ToLower() switch
                            {
                                "confirmed" or "đã xác nhận" => "bg-success",
                                "pending" or "chờ xác nhận" => "bg-warning text-dark",
                                "cancelled" or "đã hủy" => "bg-danger",
                                "completed" or "hoàn thành" => "bg-info text-dark",
                                _ => "bg-secondary"
                            };

                            <tr>
                                <td class="ps-4 fw-semibold text-muted">#@item.Id</td>
                                <td class="fw-bold text-primary">@item.FieldName</td>
                                <td>
                                    <div class="fw-medium">
                                        @item.StartAt.ToString("dd/MM/yyyy")
                                    </div>
                                    <small class="text-muted">
                                        @item.StartAt.ToString("HH:mm") - @item.EndAt.ToString("HH:mm")
                                    </small>
                                </td>
                                <td class="fw-bold text-danger">
                                    @item.TotalPrice.ToString("N0") đ
                                </td>
                                <td>
                                    <span class="badge rounded-pill @statusBadge px-3 py-2">
                                        @item.Status
                                    </span>
                                </td>
                                <td>
                                    <span class="text-muted small">
                                        @(string.IsNullOrWhiteSpace(item.Note) ? "Không có" : item.Note)
                                    </span>
                                </td>
                                <td class="text-muted">@item.CreatedAt</td>
                                <td>
                                    <a asp-action="Details" asp-controller="Bookings" asp-route-Id="@item.Id" class="btn btn-primary">
                                        <i class="bi bi-ticket-detailed"></i> 
                                        <span>Chi tiết</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>