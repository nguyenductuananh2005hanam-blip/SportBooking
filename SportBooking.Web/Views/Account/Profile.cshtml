@model ProfileViewModel

@{
    ViewData["Title"] = "Thông tin cá nhân";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <h2 class="justify-content-center align-content-center text-center">Thông tin cá nhân</h2>
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white text-center py-4">
                    <div class="rounded-circle bg-white text-primary d-inline-flex align-items-center justify-content-center mb-2" style="width: 70px; height: 70px; font-size: 2rem; font-weight: bold;">
                        @(string.IsNullOrEmpty(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())
                    </div>
                    <h4 class="mb-0">@Model.FullName</h4>
                    <small>ID: #@Model.Id</small>
                </div>

                <div class="card-body p-4">
                    <div class="mb-3 row border-bottom pb-2">
                        <label class="col-sm-4 fw-bold text-muted">Họ và tên:</label>
                        <div class="col-sm-8">@Model.FullName</div>
                    </div>

                    <div class="mb-3 row border-bottom pb-2">
                        <label class="col-sm-4 fw-bold text-muted">Email:</label>
                        <div class="col-sm-8">@Model.Email</div>
                    </div>

                    <div class="mb-3 row border-bottom pb-2">
                        <label class="col-sm-4 fw-bold text-muted">Số điện thoại:</label>
                        <div class="col-sm-8">
                            @(string.IsNullOrEmpty(Model.Phone) ? "Chưa cập nhật" : Model.Phone)
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label class="col-sm-4 fw-bold text-muted">Ngày tham gia:</label>
                        <div class="col-sm-8">@Model.Ngaytao</div>
                    </div>
                </div>

                <div class="card-footer bg-light d-flex justify-content-between py-3">
                    <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary">
                        Quay lại
                    </a>
                    <a asp-action="EditProfile" asp-route-id="@Model.Id" class="btn btn-primary">
                        Chỉnh sửa thông tin
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>