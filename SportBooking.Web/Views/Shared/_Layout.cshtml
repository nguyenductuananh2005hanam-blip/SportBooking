@using Microsoft.AspNetCore.Http
@{
    var userId = Context.Session.GetInt32("UserId");
    var userName = Context.Session.GetString("UserName");
    var Role = Context.Session.GetString("UserRole");

    var initial = string.IsNullOrWhiteSpace(userName) ? "?" : userName.Trim()[0].ToString().ToUpperInvariant();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string name) =>
        string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SportBooking</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SportBooking.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <style>
        /* ===== Design tokens (khớp tông xanh của trang chi tiết đơn đặt sân) ===== */
:root {
    --sb-primary: #198754;
    --sb-primary-dark: #157347;
    --sb-accent: #20c997;
    --sb-soft: #e9f5ef;
    --sb-ink: #1e293b;
    --sb-muted: #64748b;
    --sb-bg: #f6f8fb;
    --sb-border: #e9eef3;
    --sb-radius: 16px;
    --sb-shadow: 0 8px 24px rgba(15, 23, 42, 0.07);
    --sb-gradient: linear-gradient(135deg, #198754 0%, #20c997 100%);
}

html {
    font-size: 15px;
    min-height: 100%;
}

body {
    font-family: 'Be Vietnam Pro', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    background: var(--sb-bg);
    color: var(--sb-ink);
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}

.page-wrap {
    flex: 1;
}

a {
    color: var(--sb-primary);
}

/* ===== Navbar ===== */
.sb-navbar {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--sb-border);
    position: sticky;
    top: 0;
    z-index: 1030;
}

.sb-brand {
    font-weight: 800;
    font-size: 1.25rem;
    color: var(--sb-primary) !important;
    display: flex;
    align-items: center;
    gap: 8px;
}

.sb-brand-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--sb-gradient);
    color: #fff;
    display: grid;
    place-items: center;
}

.sb-navbar .nav-link {
    color: var(--sb-ink);
    font-weight: 500;
    padding: 0.5rem 1rem;
    border-radius: 999px;
}

.sb-navbar .nav-link:hover {
    color: var(--sb-primary);
    background: var(--sb-soft);
}

.sb-navbar .nav-link.active {
    color: var(--sb-primary);
    font-weight: 700;
    background: var(--sb-soft);
}

.sb-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--sb-gradient);
    color: #fff;
    font-weight: 700;
    display: inline-grid;
    place-items: center;
}

/* ===== Buttons ===== */
.btn-brand {
    background: var(--sb-gradient);
    border: none;
    border-radius: 999px;
    color: #fff;
    font-weight: 600;
}

.btn-brand:hover,
.btn-brand:focus {
    background: linear-gradient(135deg, #157347 0%, #1ba87e 100%);
    color: #fff;
}

.btn-outline-brand {
    border: 1.5px solid var(--sb-primary);
    color: var(--sb-primary);
    border-radius: 999px;
    font-weight: 600;
}

.btn-outline-brand:hover {
    background: var(--sb-primary);
    color: #fff;
}

/* ===== Cards & badges ===== */
.sb-card {
    background: #fff;
    border: none;
    border-radius: var(--sb-radius);
    box-shadow: var(--sb-shadow);
}

.badge-soft {
    background: var(--sb-soft);
    color: var(--sb-primary-dark);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    font-size: 0.82rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
}

.section-heading {
    font-weight: 800;
    letter-spacing: -0.01em;
}

/* ===== Hero ===== */
.hero {
    background: var(--sb-gradient);
    color: #fff;
    border-radius: 24px;
    padding: 72px 32px;
    position: relative;
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(25, 135, 84, 0.25);
}

.hero::before,
.hero::after {
    content: "";
    position: absolute;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
}

.hero::before { width: 320px; height: 320px; top: -120px; right: -80px; }
.hero::after  { width: 220px; height: 220px; bottom: -100px; left: -60px; }

.hero > * { position: relative; z-index: 1; }

.hero h1 {
    font-weight: 800;
    font-size: clamp(1.9rem, 4vw, 3rem);
    line-height: 1.2;
}

.hero-search {
    background: #fff;
    border-radius: 999px;
    padding: 6px;
    display: flex;
    gap: 6px;
    max-width: 560px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
}

.hero-search input {
    border: none;
    box-shadow: none;
    background: transparent;
    padding-left: 18px;
}

.hero-search input:focus { box-shadow: none; }

/* ===== Features & steps ===== */
.feature-icon {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: var(--sb-soft);
    color: var(--sb-primary);
    display: grid;
    place-items: center;
    font-size: 1.5rem;
}

.step-number {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--sb-gradient);
    color: #fff;
    font-weight: 700;
    display: grid;
    place-items: center;
    flex-shrink: 0;
}

/* ===== Venue cards ===== */
.venue-card {
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.venue-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 32px rgba(15, 23, 42, 0.12);
}

.venue-thumb {
    width: 100%;
    height: 190px;
    object-fit: cover;
    background: #dfe7e2;
}

.price-from {
    color: var(--sb-primary);
    font-weight: 700;
}

/* ===== Venue detail ===== */
.venue-header {
    background: var(--sb-gradient);
    color: #fff;
    border-radius: var(--sb-radius);
    padding: 28px 32px;
    box-shadow: 0 8px 24px rgba(25, 135, 84, 0.2);
}

.price-table th {
    font-size: 0.8rem;
    color: var(--sb-muted);
    font-weight: 600;
    border-bottom-width: 1px;
}

.price-table td { vertical-align: middle; }

/* ===== Footer ===== */
.sb-footer {
    background: #0f172a;
    color: #cbd5e1;
    margin-top: 56px;
    padding: 48px 0 24px;
}

.sb-footer h6 { color: #fff; font-weight: 700; }
.sb-footer a { color: #cbd5e1; text-decoration: none; }
.sb-footer a:hover { color: var(--sb-accent); }
.sb-footer .footer-bottom { border-top: 1px solid #1e293b; margin-top: 32px; padding-top: 20px; font-size: 0.88rem; }
    </style>
    <header>
        <nav class="navbar navbar-expand-lg sb-navbar">
            <div class="container">
                <a class="navbar-brand sb-brand" asp-controller="Home" asp-action="Index">
                    <span class="sb-brand-icon"><i class="bi bi-dribbble"></i></span>
                    SportBooking
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Active("Venues")" asp-controller="Venues" asp-action="Index">Sân bóng</a>
                        </li>
                        @if (userId != null)
                        {
                          <li class="nav-item">
                             <a class="nav-link @Active("Bookings")" asp-controller="Bookings" asp-action="GetBookingHistoried" asp-route-id="@userId">Đơn đặt sân</a>
                          </li>
                         }
                         @if (Role == "Admin")
                            {
                                <li class="nav-item">
                                    <a class="nav-link @Active("")" asp-controller="" asp-action="">
                                        <i class="bi bi-gear"></i> Trang quản lý</a>
                                </li>
                            }
                    </ul>

                    @if (userId == null)
                    {
                        <div class="d-flex gap-2">
                            <a class="btn btn-outline-brand px-4" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                            <a class="btn btn-brand px-4" asp-controller="Account" asp-action="Register">Đăng ký</a>
                        </div>
                    }
                    else
                    {
                        <div class="dropdown">
                            <a class="nav-link d-flex align-items-center gap-2 dropdown-toggle" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="sb-avatar">@initial</span>
                                <span class="d-none d-lg-inline fw-semibold">@userName</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end border-0 shadow rounded-3">
                                <li><span class="dropdown-item-text text-muted small">Xin chào, <strong>@userName</strong></span></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="Profile" asp-route-id="@userId">
                                        <i class="bi bi-person me-2"></i>Thông tin tài khoản
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="ChangesPassword" asp-route-id="@userId">
                                        <i class="bi bi-key me-2"></i>Thay đổi mật khẩu
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Bookings" asp-action="GetBookingHistoried" asp-route-id="@userId">
                                        <i class="bi bi-list-check me-2"></i>Thông tin đặt sân
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="page-wrap">
        <div class="container pt-3">
            @if (TempData["Success"] is string successMsg)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@successMsg
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }
            @if (TempData["Error"] is string errorMsg)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMsg
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }
        </div>

        <main role="main" class="container pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="sb-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-5">
                    <div class="sb-brand mb-3" style="color:#fff !important;">
                        <span class="sb-brand-icon"><i class="bi bi-dribbble"></i></span> SportBooking
                    </div>
                    <p class="mb-0">Nền tảng đặt sân thể thao trực tuyến: tìm sân, đặt lịch chỉ trong vài bước.</p>
                </div>
                <div class="col-6 col-lg-3 offset-lg-1">
                    <h6 class="mb-3">Khám phá</h6>
                    <ul class="list-unstyled mb-0 d-grid gap-2">
                        <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li><a asp-controller="Venues" asp-action="Index">Danh sách sân</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-3">
                    <h6 class="mb-3">Tài khoản</h6>
                    <ul class="list-unstyled mb-0 d-grid gap-2">
                        @if (userId == null)
                        {
                            <li><a asp-controller="Account" asp-action="Login">Đăng nhập</a></li>
                            <li><a asp-controller="Account" asp-action="Register">Đăng ký</a></li>
                        }
                        else
                        {
                            <li><a asp-controller="Bookings" asp-action="GetBookingHistoried" asp-route-id="@userId">Đơn đặt sân</a></li>
                            <li><a asp-controller="Account" asp-action="Profile" asp-route-id="@userId">Thông tin tài khoản</a></li>
                        }
                    </ul>
                </div>
            </div>
            <div class="footer-bottom text-center">&copy; @DateTime.Now.Year SportBooking.</div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>